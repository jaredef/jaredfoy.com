    <!-- ============================================================ -->
    <!-- PROTECTIVE BELT — DISCIPLINES                                -->
    <!-- ============================================================ -->
    <section class="schema-tier pb-discipline">
      <p class="tier-label">Protective Belt — Disciplines</p>
      <h2>The six standing Disciplines (PB-Discipline-1 through PB-Discipline-6)</h2>
      <p class="tier-desc">Operational machinery that makes the programme function as Lakatosian-progressive. Audit machinery; truth-telling discipline; substrate-keeper composition; coherent-confabulation discipline.</p>
      <div class="doc-cards">
        <a class="doc-card" href="/resolve/doc/314-the-virtue-constraints" data-tier="W-CANONICAL">
          <span class="doc-num">Doc 314</span>
          <span class="doc-title">V3 Truth-Telling (Virtue Constraints)</span>
