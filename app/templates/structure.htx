    <!-- ============================================================ -->
    <!-- STANDING APPARATUS                                           -->
    <!-- ============================================================ -->
    <section class="schema-tier standing">
      <p class="tier-label">Standing Apparatus</p>
      <h2>Structurally load-bearing across the programme</h2>
      <p class="tier-desc">Not Forms, not Disciplines, but indispensable to how the programme operates. Doc 372 disciplines what the structural articulations license; Doc 548 supplies the rung-grammar; Doc 572 extends it; Doc 620 disambiguates the role-vs-warrant senses of "canonical."</p>
      <div class="doc-cards">
        <a class="doc-card" href="/resolve/doc/372-the-hypostatic-boundary" data-tier="W-METAPHYSICAL">
