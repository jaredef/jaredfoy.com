          <div class="doc-tags"><span class="tag">HARD-CORE</span></div>
        </a>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- META-PRIMARY                                                 -->
    <!-- ============================================================ -->
    <section class="schema-tier" style="border-left: 4px solid #d4a017;">
      <p class="tier-label">Meta-Primary</p>
      <h2>The corpus's primary articulation of itself</h2>
      <p class="tier-desc">The single document that articulates the corpus as a coherent integrated whole. Reading this document specifies what every other document is structurally for.</p>
      <div class="doc-cards">
        <a class="doc-card" href="/resolve/doc/632-the-corpus-itself-primary-articulation" data-tier="W-PI">
          <span class="doc-num">Doc 632</span>
          <span class="doc-title">The RESOLVE Corpus, Primary Articulation</span>
