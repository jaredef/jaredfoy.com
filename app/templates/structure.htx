<script>
  // Status filter toggle: default-hides historical-archival layer.
  // Persists user choice via localStorage.
  (function() {
    var KEY = 'structure-show-historical';
    var toggle = document.getElementById('toggle-historical');
    if (!toggle) return;
    var stored = false;
    try { stored = localStorage.getItem(KEY) === '1'; } catch (e) {}
    toggle.checked = stored;
    document.body.classList.toggle('show-historical', stored);
    toggle.addEventListener('change', function() {
      document.body.classList.toggle('show-historical', toggle.checked);
      try { localStorage.setItem(KEY, toggle.checked ? '1' : '0'); } catch (e) {}
    });
  })();
</script>
