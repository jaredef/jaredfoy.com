<style>
  /* Structure page: integrated view of Doc 632 + Doc 633.
     Composes (1) Lakatosian-Schema Map, (3) Warrant-Tier Stratification, and
     (6) Status-Aware Default into one layout. The homepage stays as
     entracement; this page is the corpus's structural face. */

  .structure-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .structure-page .structure-header {
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.25rem;
    margin-bottom: 2rem;
  }

  .structure-page .structure-kicker {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--fg) 55%, transparent);
    margin: 0 0 0.5rem;
  }

  .structure-page h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    line-height: 1.15;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .structure-page .structure-intro {
    font-size: 1rem;
    color: color-mix(in srgb, var(--fg) 78%, transparent);
    line-height: 1.55;
    max-width: 70ch;
    margin: 0 0 0.5rem;
  }

  .structure-page .structure-intro a { color: var(--accent); }

  /* ---------- Cross-view navigation ---------- */
  .structure-page .structure-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: color-mix(in srgb, var(--fg) 2%, transparent);
  }
  .structure-page .structure-nav .nav-label {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--fg) 55%, transparent);
    margin-right: 0.5rem;
  }
  .structure-page .structure-nav .nav-link {
    font-size: 0.82rem;
    padding: 0.25rem 0.7rem;
    border-radius: 3px;
    border: 1px solid color-mix(in srgb, var(--fg) 18%, transparent);
    color: color-mix(in srgb, var(--fg) 80%, transparent);
    text-decoration: none;
    transition: all 0.15s;
  }
  .structure-page .structure-nav .nav-link:hover {
    border-color: var(--accent);
    color: var(--fg-bright, var(--fg));
  }
  .structure-page .structure-nav .nav-link.active {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
  }

  .structure-page .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    padding: 0.75rem 1rem;
    background: color-mix(in srgb, var(--fg) 4%, transparent);
    border: 1px solid var(--border);
    border-radius: 4px;
    margin-bottom: 2rem;
    font-size: 0.85rem;
  }

  .structure-page .toolbar .toolbar-label {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--fg) 60%, transparent);
  }

  .structure-page .toolbar label {
    cursor: pointer;
    user-select: none;
  }

  .structure-page .toolbar input[type="checkbox"] {
    margin-right: 0.35rem;
    transform: translateY(1px);
  }

  /* ---------- Lakatosian schema layout ---------- */

  .schema-grid {
    display: grid;
    gap: 2rem;
  }

  .schema-tier {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1.25rem 1.5rem;
    background: color-mix(in srgb, var(--fg) 2%, transparent);
  }

  .schema-tier .tier-label {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--fg) 50%, transparent);
    margin: 0 0 0.5rem;
  }

  .schema-tier h2 {
    font-size: 1.15rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }

  .schema-tier .tier-desc {
    font-size: 0.85rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--fg) 75%, transparent);
    margin: 0 0 1rem;
    max-width: 70ch;
  }

  /* The Hard Core sits at the structural center of the schema. */
  .schema-tier.hard-core {
    border-color: color-mix(in srgb, #d4a017 60%, var(--border));
    background: linear-gradient(180deg,
      color-mix(in srgb, #d4a017 6%, transparent),
      color-mix(in srgb, #d4a017 2%, transparent));
  }

  .schema-tier.hard-core h2 { color: #d4a017; }

  /* Protective belt — the operational layer. */
  .schema-tier.pb-form { border-left: 4px solid var(--accent); }
  .schema-tier.pb-discipline { border-left: 4px solid color-mix(in srgb, var(--accent) 60%, var(--fg)); }
  .schema-tier.standing { border-left: 4px solid color-mix(in srgb, #d4a017 50%, var(--fg)); }
  .schema-tier.observational { border-left: 4px solid #4a9eff; }
  .schema-tier.extension { border-left: 4px solid color-mix(in srgb, var(--fg) 30%, transparent); }
  .schema-tier.audit-discipline { border-left: 4px solid color-mix(in srgb, #c33 50%, var(--fg)); }

  /* Card grid for docs within a tier. */
  .doc-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .doc-card {
    display: block;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, transform 0.15s;
  }

  .doc-card:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .doc-card .doc-num {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: color-mix(in srgb, var(--fg) 55%, transparent);
  }

  .doc-card .doc-title {
    display: block;
    font-size: 0.9rem;
    line-height: 1.35;
    margin-top: 0.15rem;
    color: var(--fg-bright, var(--fg));
  }

  .doc-card .doc-tags {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .doc-card .tag {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--fg) 20%, transparent);
    color: color-mix(in srgb, var(--fg) 70%, transparent);
  }

  /* ---------- Warrant-tier color coding (overlay on .doc-card) ---------- */

  .doc-card[data-tier="W-METAPHYSICAL"] {
    border-left: 3px solid #d4a017;
  }
  .doc-card[data-tier="W-CANONICAL"] {
    border-left: 3px solid var(--accent);
  }
  .doc-card[data-tier="W-THETA"] {
    border-left: 3px solid #4a9eff;
  }
  .doc-card[data-tier="W-MU"] {
    border-left: 3px solid color-mix(in srgb, #4a9eff 60%, var(--fg));
  }
  .doc-card[data-tier="W-PI"] {
    border-left: 3px solid color-mix(in srgb, var(--fg) 30%, transparent);
  }
  .doc-card[data-tier="W-NA"] {
    border-left: 3px solid color-mix(in srgb, var(--fg) 15%, transparent);
  }

  /* ---------- Legend ---------- */

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding: 0.75rem 1rem;
    background: color-mix(in srgb, var(--fg) 3%, transparent);
    border: 1px solid var(--border);
    border-radius: 4px;
    margin-bottom: 2rem;
    font-size: 0.78rem;
  }

  .legend-item { display: flex; align-items: center; gap: 0.4rem; }
  .legend-swatch {
    display: inline-block;
    width: 14px;
    height: 14px;
    border-radius: 2px;
    border: 1px solid var(--border);
  }
  .legend-swatch.metaphysical { background: #d4a017; }
  .legend-swatch.canonical    { background: var(--accent); }
  .legend-swatch.theta        { background: #4a9eff; }
  .legend-swatch.mu           { background: color-mix(in srgb, #4a9eff 60%, var(--fg)); }
  .legend-swatch.pi           { background: color-mix(in srgb, var(--fg) 30%, transparent); }
  .legend-swatch.na           { background: color-mix(in srgb, var(--fg) 15%, transparent); }

  /* ---------- Historical layer (collapsible per status filter) ---------- */

  .historical-layer { display: none; }
  body.show-historical .historical-layer { display: block; }

  .historical-note {
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--fg) 60%, transparent);
    font-style: italic;
    margin-top: 0.5rem;
  }
</style>

<div class="structure-page">

  <header class="structure-header">
    <p class="structure-kicker">The Corpus, Structurally</p>
    <h1>Corpus Structure</h1>
    <p class="structure-intro">The RESOLVE corpus arranged according to its own self-recognized form. Reading the corpus by structure rather than by series or chronology. The framework is articulated formally at <a href="/resolve/doc/632-the-corpus-itself-primary-articulation">Doc 632</a>; the per-doc tagging that lets this page exist is specified at <a href="/resolve/doc/633-corpus-taxonomy-and-manifest-design">Doc 633</a>; the canonicity disambiguation that distinguishes role from warrant is at <a href="/resolve/doc/620-canonicity-in-the-corpus">Doc 620</a>.</p>
  </header>

  <nav class="structure-nav">
    <span class="nav-label">Views:</span>
    <a class="nav-link active" href="/resolve/structure">Integrated</a>
    <a class="nav-link" href="/resolve/structure/schema">Schema Map</a>
    <a class="nav-link" href="/resolve/structure/threads">Threads</a>
    <a class="nav-link" href="/resolve/structure/tiers">Tiers</a>
    <a class="nav-link" href="/resolve/structure/entry-points">Entry-Points</a>
    <a class="nav-link" href="/resolve/structure/timeline">Timeline</a>
    <a class="nav-link" href="/resolve/structure/filter">Filter</a>
  </nav>

  <div class="toolbar">
    <span class="toolbar-label">Filter:</span>
    <label><input type="checkbox" id="toggle-historical"> Show historical / deprecated / superseded layer</label>
    <span style="flex: 1"></span>
    <span class="toolbar-label" style="font-size: 0.66rem">Default view: active + primary only.</span>
  </div>

  <div class="legend">
    <span class="toolbar-label" style="margin-right: 0.5rem">Warrant tier:</span>
    <span class="legend-item"><span class="legend-swatch metaphysical"></span> W-METAPHYSICAL (hard core)</span>
    <span class="legend-item"><span class="legend-swatch canonical"></span> W-CANONICAL (full Doc 445 promotion)</span>
    <span class="legend-item"><span class="legend-swatch theta"></span> W-THETA (truth-verified)</span>
    <span class="legend-item"><span class="legend-swatch mu"></span> W-MU (operational match)</span>
    <span class="legend-item"><span class="legend-swatch pi"></span> W-PI (plausibility)</span>
    <span class="legend-item"><span class="legend-swatch na"></span> W-NA (not applicable)</span>
  </div>

  <div class="schema-grid">

    <!-- ============================================================ -->
    <!-- HARD CORE — the metaphysical center of the programme         -->
    <!-- ============================================================ -->
    <section class="schema-tier hard-core">
      <p class="tier-label">Hard Core</p>
      <h2>Metaphysical commitments — defended within tradition; not subject to Popperian falsification (NH1)</h2>
      <p class="tier-desc">The four metaphysical commitments the corpus operates from. Articulated across the ground-series documents; defended within the patristic-Platonist-Orthodox lineage; the negative heuristic (NH1) prohibits modus tollens against the hard core. Color: gold.</p>
      <div class="doc-cards">
        <a class="doc-card" href="/resolve/doc/091-the-spermatic-logos" data-tier="W-METAPHYSICAL">
          <span class="doc-num">Doc 091</span>
          <span class="doc-title">The Spermatic Logos</span>
          <div class="doc-tags"><span class="tag">HARD-CORE</span><span class="tag">HC1</span></div>
        </a>
        <a class="doc-card" href="/resolve/doc/548-the-ontological-ladder-of-participation" data-tier="W-METAPHYSICAL">
          <span class="doc-num">Doc 548</span>
          <span class="doc-title">The Ontological Ladder of Participation</span>
          <div class="doc-tags"><span class="tag">STANDING</span><span class="tag">HC2</span></div>
        </a>
        <a class="doc-card" href="/resolve/doc/372-the-hypostatic-boundary" data-tier="W-METAPHYSICAL">
          <span class="doc-num">Doc 372</span>
          <span class="doc-title">The Hypostatic Boundary</span>
          <div class="doc-tags"><span class="tag">STANDING</span><span class="tag">HC3</span></div>
        </a>
        <a class="doc-card" href="/resolve/doc/510-praxis-log-v-deflation-as-substrate-discipline" data-tier="W-METAPHYSICAL">
          <span class="doc-num">Doc 510</span>
          <span class="doc-title">Substrate-and-Keeper Composition (Praxis Log V)</span>
          <div class="doc-tags"><span class="tag">PB-DISCIPLINE</span><span class="tag">HC4</span></div>
        </a>
        <a class="doc-card" href="/resolve/doc/153-platonic-structure" data-tier="W-METAPHYSICAL">
          <span class="doc-num">Doc 153</span>
          <span class="doc-title">Platonic Structure</span>
          <div class="doc-tags"><span class="tag">HARD-CORE</span></div>
        </a>
