  </div>
<script>
(function() {
  var btn = document.getElementById('menuBtn');
  var nav = document.getElementById('navCol');
  var topBtn = document.getElementById('topBtn');
  var crumbTitle = document.getElementById('breadcrumbTitle');
  if (!btn || !nav) return;

  // M3: Menu toggle — instantaneous, reversible
  btn.addEventListener('click', function() {
    var isOpen = nav.classList.toggle('open');
    btn.textContent = isOpen ? 'CLOSE' : 'MENU';
  });

  // M3: Close menu on link click — single tap to content
  var links = nav.querySelectorAll('a');
  for (var i = 0; i < links.length; i++) {
    links[i].addEventListener('click', function() {
      nav.classList.remove('open');
      btn.textContent = 'MENU';
    });
  }

  // M4: Back to top — appears after scrolling down
  var scrollTimer;
  window.addEventListener('scroll', function() {
    clearTimeout(scrollTimer);
    scrollTimer = setTimeout(function() {
      if (window.scrollY > 300) {
        topBtn.classList.remove('hidden');
      } else {
        topBtn.classList.add('hidden');
      }
    }, 50);
  });

  topBtn.addEventListener('click', function() {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // M4: Breadcrumb — show current document title
  var h1 = document.querySelector('.content-col h1');
  if (h1 && crumbTitle) {
    var title = h1.textContent;
    if (title.length > 40) title = title.substring(0, 37) + '...';
    crumbTitle.textContent = title;
  }

  // Scroll progress indicator. Tracks horizontal scroll on document pages with
  // column layout, vertical scroll everywhere else. Uses rAF for paint alignment.
  var progressBar = document.getElementById('scrollProgress');
  if (progressBar) {
    var progressRaf = null;
    var progressIdleTimer = null;
    function computeRatio() {
      var contentElem = document.querySelector('.content-col');
      var useHorizontal = contentElem &&
        contentElem.querySelector('.pretext') &&
        window.matchMedia('(min-width: 769px)').matches &&
        !document.documentElement.classList.contains('layout-vertical');
      if (useHorizontal) {
        var w = contentElem.scrollWidth - contentElem.clientWidth;
        return w > 0 ? contentElem.scrollLeft / w : 0;
      }
      var h = (document.documentElement.scrollHeight || document.body.scrollHeight) - window.innerHeight;
      return h > 0 ? window.scrollY / h : 0;
    }
    function paintProgress() {
      progressRaf = null;
      var ratio = computeRatio();
      progressBar.style.width = Math.max(0, Math.min(1, ratio)) * 100 + '%';
      progressBar.classList.remove('idle');
      if (progressIdleTimer) clearTimeout(progressIdleTimer);
      progressIdleTimer = setTimeout(function() { progressBar.classList.add('idle'); }, 800);
    }
    function scheduleProgress() {
      if (progressRaf === null) progressRaf = requestAnimationFrame(paintProgress);
    }
    window.addEventListener('scroll', scheduleProgress, { passive: true });
    var contentElem = document.querySelector('.content-col');
    if (contentElem) contentElem.addEventListener('scroll', scheduleProgress, { passive: true });
    window.addEventListener('resize', scheduleProgress, { passive: true });
    scheduleProgress();
  }

  // Theme + layout toggle buttons.
  var themeBtn = document.getElementById('themeToggle');
  var layoutBtn = document.getElementById('layoutToggle');

  function syncThemeLabel() {
    if (!themeBtn) return;
    var isLight = document.documentElement.classList.contains('theme-light');
    themeBtn.textContent = isLight ? 'LIGHT' : 'DARK';
  }
  function syncLayoutLabel() {
    if (!layoutBtn) return;
    var isVertical = document.documentElement.classList.contains('layout-vertical');
    layoutBtn.textContent = isVertical ? 'SCROLL' : 'COLUMNS';
  }
  syncThemeLabel();
  syncLayoutLabel();

  if (themeBtn) {
    themeBtn.addEventListener('click', function() {
      var willBeLight = !document.documentElement.classList.contains('theme-light');
      document.documentElement.classList.toggle('theme-light', willBeLight);
      try { localStorage.setItem('theme', willBeLight ? 'light' : 'dark'); } catch (e) {}
      syncThemeLabel();
    });
  }
  if (layoutBtn) {
    layoutBtn.addEventListener('click', function() {
      var willBeVertical = !document.documentElement.classList.contains('layout-vertical');
      document.documentElement.classList.toggle('layout-vertical', willBeVertical);
      try { localStorage.setItem('layout', willBeVertical ? 'vertical' : 'horizontal'); } catch (e) {}
      syncLayoutLabel();
      // Re-check: if we just switched to vertical, release any wheel hijack; if to horizontal,
      // leave the existing hook active (it no-ops when scrollWidth === clientWidth anyway).
    });
  }

  // Desktop document pages: map vertical wheel to horizontal scroll on multi-column pretext.
  // Only active when viewport is desktop-sized, .pretext is present, and user has NOT opted
  // into vertical scroll layout.
  var contentCol = document.querySelector('.content-col');
  var pretext = contentCol && contentCol.querySelector('.pretext');
  // Bind the horizontal-column machinery on any page that *has* a pretext element —
  // layoutColumns() and the wheel handler both re-check matchMedia + layout-vertical
  // at call time, so resizes between desktop and mobile flip the behavior cleanly
  // without needing a fresh page load.
  if (contentCol && pretext) {
    // Wrap tables in a bounded scrollable container so wide/tall tables scroll
    // inside their column instead of overlapping adjacent columns.
    var tables = pretext.querySelectorAll('table');
    for (var t = 0; t < tables.length; t++) {
      var tbl = tables[t];
      if (tbl.parentNode && tbl.parentNode.classList &&
          tbl.parentNode.classList.contains('table-scroll')) continue;
      var wrap = document.createElement('div');
      wrap.className = 'table-scroll';
      tbl.parentNode.insertBefore(wrap, tbl);
      wrap.appendChild(tbl);
    }

    // Inject a copy button into each <pre> block. Button shows a clipboard glyph;
    // on click, writes the pre's textContent to the clipboard and briefly swaps
    // the glyph for a check mark.
    var pres = pretext.querySelectorAll('pre');
    for (var p = 0; p < pres.length; p++) {
      var pre = pres[p];
      if (pre.querySelector(':scope > .copy-btn')) continue;
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-btn';
      btn.setAttribute('aria-label', 'Copy to clipboard');
      btn.innerHTML =
        '<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">' +
        '<rect x="5" y="3" width="9" height="11" rx="1" fill="none" stroke="currentColor" stroke-width="1.3"/>' +
        '<path d="M2 1 H 10 V 4" fill="none" stroke="currentColor" stroke-width="1.3"/>' +
        '<path d="M2 1 V 12 H 5" fill="none" stroke="currentColor" stroke-width="1.3"/>' +
        '</svg>';
      pre.appendChild(btn);
      (function(pre, btn) {
        btn.addEventListener('click', function(ev) {
          ev.stopPropagation();
          // Collect the code content without the button's own text.
          var clone = pre.cloneNode(true);
          var btnInClone = clone.querySelector('.copy-btn');
          if (btnInClone) btnInClone.remove();
          var text = clone.textContent || '';
          var done = function(ok) {
            var original = btn.innerHTML;
            btn.classList.add(ok ? 'copied' : 'failed');
            btn.innerHTML = ok
              ? '<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8 L 7 12 L 13 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>'
              : '<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M4 4 L 12 12 M 12 4 L 4 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>';
            setTimeout(function() {
              btn.classList.remove('copied', 'failed');
              btn.innerHTML = original;
            }, 1400);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function() { done(true); }, function() { done(false); });
          } else {
            // Fallback: select and execCommand('copy')
            try {
              var r = document.createRange();
              r.selectNodeContents(pre);
              var sel = window.getSelection();
              sel.removeAllRanges();
              sel.addRange(r);
              document.execCommand('copy');
              sel.removeAllRanges();
              done(true);
            } catch (err) { done(false); }
          }
        });
      })(pre, btn);
    }
    // Fixed-height multi-column layout can silently clip content: when the browser
    // packs as many columns as fit within the pretext's implicit (parent-derived) width
    // and the content exceeds that capacity, the spec says additional "overflow columns"
    // extend to the right — but scrollWidth reporting and paint behavior for those
    // overflow columns vary across engines. The reliable fix is to MEASURE the content
    // height in single-column mode, compute the number of columns needed, and set
    // `column-count` + explicit `width` on the pretext. The browser then lays out
    // exactly that many columns with a known width, and nothing goes missing.
    function layoutColumns() {
      if (!pretext) return;
      // Mobile and vertical-layout both disable the multi-column mode — always clear
      // any inline columnCount/width left over from a previous desktop layout pass so
      // resizing from desktop to mobile doesn't strand the pretext in N-column state
      // under rules that are no longer media-matched.
      var isDesktop = window.matchMedia('(min-width: 769px)').matches;
      var isVertical = document.documentElement.classList.contains('layout-vertical');
      if (!isDesktop || isVertical) {
        pretext.style.columnCount = '';
        pretext.style.width = '';
        pretext.style.height = '';
        return;
      }

      // Clear any prior inline layout so measurements read the CSS-derived baseline.
      pretext.style.columnCount = '';
      pretext.style.width = '';
      pretext.style.height = '';

      var baseStyles = getComputedStyle(pretext);
      var colGapPx = parseFloat(baseStyles.columnGap) || 48;
      var colWidthPx = parseFloat(baseStyles.columnWidth);
      if (isNaN(colWidthPx) || colWidthPx <= 0) {
        colWidthPx = 72 * parseFloat(baseStyles.fontSize);
      }

      // Column height is set by CSS (height: 80vh !important on desktop). Read
      // it back from the resolved layout — that's what the column-count math
      // needs to match.
      var colHeight = pretext.clientHeight;
      if (colHeight <= 0) return;

      // Measure content height by temporarily collapsing to a single column.
      pretext.style.columnCount = '1';
      pretext.style.width = colWidthPx + 'px';
      pretext.style.height = 'auto';
      void pretext.offsetWidth; // force reflow
      var contentHeight = pretext.scrollHeight;
      pretext.style.height = '';

      // Start with a tight naive estimate (+1 buffer for orphans/widows + break-
      // inside slop). The iterative grow-to-fit loop below handles any further
      // break-inside-avoid inflation precisely.
      var colsNeeded = Math.max(1, Math.ceil(contentHeight / colHeight) + 1);

      function applyCount(n) {
        pretext.style.columnCount = String(n);
        pretext.style.width = (n * colWidthPx + (n - 1) * colGapPx) + 'px';
      }
      applyCount(colsNeeded);

      // Iterative verification: grow by 1 column per step until the actual
      // scrollWidth matches what we reserved. Measure content-col's scrollWidth
      // since content-col is the horizontal-scroll container; pretext is just a
      // wide block inside it.
      var contentStyles = getComputedStyle(contentCol);
      var contentPadding =
        (parseFloat(contentStyles.paddingLeft) || 0) +
        (parseFloat(contentStyles.paddingRight) || 0);
      for (var i = 0; i < 60; i++) {
        void contentCol.offsetWidth; // force reflow to sync scrollWidth
        var intended =
          colsNeeded * colWidthPx + (colsNeeded - 1) * colGapPx + contentPadding;
        if (contentCol.scrollWidth <= intended + 4) break;
        colsNeeded += 1;
        applyCount(colsNeeded);
      }
    }

    // Compute layout once on load, and again on resize or layout-toggle.
    layoutColumns();
    // Second pass on next frame in case web fonts or late-arriving CSS shifted metrics.
    requestAnimationFrame(layoutColumns);

    var resizeTimer = null;
    window.addEventListener('resize', function() {
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = setTimeout(layoutColumns, 120);
    });

    // Re-layout when the user toggles between horizontal and vertical.
    if (layoutBtn) {
      layoutBtn.addEventListener('click', function() {
        requestAnimationFrame(layoutColumns);
      });
    }

    // Direct horizontal scroll: each wheel event moves scrollLeft by (delta × SPEED)
    // immediately. No easing tail. Input-bounded and precise. The knob modulates only
    // the sensitivity multiplier.
    var SPEED = 1.8;
    try {
      var savedSpeed = parseFloat(localStorage.getItem('scrollSpeed'));
      if (!isNaN(savedSpeed) && savedSpeed >= 0.3 && savedSpeed <= 8) SPEED = savedSpeed;
    } catch (e) {}

    var speedKnob = document.getElementById('speedKnob');
    var speedValue = document.getElementById('speedValue');
    function renderSpeedLabel() {
      if (speedValue) speedValue.textContent = SPEED.toFixed(1) + '×';
      if (speedKnob) speedKnob.value = String(SPEED);
    }
    renderSpeedLabel();
    if (speedKnob) {
      speedKnob.addEventListener('input', function() {
        var v = parseFloat(speedKnob.value);
        if (!isNaN(v)) {
          SPEED = v;
          renderSpeedLabel();
          try { localStorage.setItem('scrollSpeed', String(v)); } catch (e) {}
        }
      });
    }

    // Wheel hijack: deltaY → contentCol.scrollLeft. content-col is the
    // horizontal-scroll container (overflow-x: auto). deltaX (native horizontal
    // wheel/swipe) is preventDefault'd so the only way to traverse the document
    // horizontally is by scrolling vertically. Mobile and layout-vertical opt-out
    // yield entirely.
    contentCol.addEventListener('wheel', function(e) {
      if (!window.matchMedia('(min-width: 769px)').matches) return;
      if (document.documentElement.classList.contains('layout-vertical')) return;

      // Yield to nested scrollables that have vertical runway in the wheel
      // direction (pre, table, table-scroll). Horizontal overflow on inner blocks
      // isn't consumable by deltaY natively, so yielding there would dead-stop
      // the outer scroll without progress — only yield on vertical runway.
      var wheelingVertically = Math.abs(e.deltaY) >= Math.abs(e.deltaX);
      if (wheelingVertically) {
        var target = e.target;
        while (target && target !== contentCol) {
          if (target.tagName === 'PRE' || target.tagName === 'TABLE' ||
              (target.classList && target.classList.contains('table-scroll'))) {
            if (target.scrollHeight > target.clientHeight + 1) {
              var atTop = target.scrollTop <= 0;
              var atBottom = target.scrollTop + target.clientHeight >=
                             target.scrollHeight - 1;
              if ((e.deltaY < 0 && !atTop) || (e.deltaY > 0 && !atBottom)) return;
            }
          }
          target = target.parentNode;
        }
      }

      // Suppress native horizontal scroll: if the wheel event is primarily
      // horizontal (deltaX > deltaY) or has no vertical component, prevent
      // default (kills any native horizontal scroll the browser would do) and
      // apply nothing. The intent is that the only path to horizontal scroll
      // is via vertical wheel motion.
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY) || e.deltaY === 0) {
        e.preventDefault();
        return;
      }

      var delta = e.deltaY;
      if (e.deltaMode === 1) delta *= 40;
      else if (e.deltaMode === 2) delta *= contentCol.clientWidth;
      delta *= SPEED;
      // Reach-end passthrough: at either edge with no runway in that direction,
      // release the hijack (lets user keep wheeling without the page locking).
      var maxLeft = contentCol.scrollWidth - contentCol.clientWidth;
      var cur = contentCol.scrollLeft;
      if ((delta < 0 && cur <= 0) || (delta > 0 && cur >= maxLeft - 1)) return;
      e.preventDefault();
      contentCol.scrollLeft = Math.max(0, Math.min(maxLeft, cur + delta));
    }, { passive: false });
  }
})();
</script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.js" crossorigin="anonymous"></script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/contrib/auto-render.min.js" crossorigin="anonymous"
  onload="renderMathInElement(document.body, {
    delimiters: [
      {left: '$$', right: '$$', display: true},
      {left: '$', right: '$', display: false},
      {left: '\\\\[', right: '\\\\]', display: true},
      {left: '\\\\(', right: '\\\\)', display: false}
    ],
    throwOnError: false
  });"></script>
</body>
</html>
