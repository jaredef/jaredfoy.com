        <div class="toggle-row">
          <button class="toggle-btn" id="themeToggle" aria-label="Toggle theme" title="Toggle light/dark theme">THEME</button>
          <button class="toggle-btn layout-only" id="layoutToggle" aria-label="Toggle layout" title="Toggle columns/scroll layout">LAYOUT</button>
        </div>
        <div class="knob-row layout-only">
          <label for="speedKnob" class="knob-label">SCROLL <span id="speedValue">1.8×</span></label>
          <input type="range" id="speedKnob" class="knob" min="0.3" max="8" step="0.1" value="1.8" aria-label="Horizontal scroll speed">
        </div>
