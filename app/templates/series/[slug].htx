<style>
  /* Series-page styling. The body_html is generated by seed-corpus.ts. */
  .series-page .series-header {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }

  .series-page .series-kicker {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--fg) 55%, transparent);
    margin: 0 0 0.5rem;
  }

  .series-page h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.1;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .series-page .series-desc {
    font-size: 1.05rem;
    color: color-mix(in srgb, var(--fg) 82%, transparent);
    margin: 0 0 0.75rem;
    font-style: italic;
  }

  .series-page .series-count {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--fg) 55%, transparent);
    margin: 0;
  }

  .series-page .series-count a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted currentColor;
  }

  .series-page .series-section {
    margin: 2rem 0;
  }

  .series-page .series-section h2 {
    font-size: 1.2rem;
    margin: 0 0 0.4rem;
  }

  .series-page .series-section .section-desc {
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--fg) 75%, transparent);
    margin: 0 0 1rem;
  }

  @media (max-width: 768px) {
    .series-page h1 { font-size: 1.7rem; }
    .series-page .series-desc { font-size: 0.98rem; }
  }
</style>

<htx:type>series</htx:type>
<htx:slug>{{ route.slug }}</htx:slug>
<htx>
<htx:each>
__body_html__
</htx:each>
<htx:none>
<article class="document">
  <h1>Series Not Found</h1>
  <p>The requested series does not exist. <a href="/">Return to the index</a> for the full list of curated reading paths.</p>
</article>
</htx:none>
</htx>
