<htx:type>corpus</htx:type>
<htx:slug>{{ route.slug }}</htx:slug>
<htx>
<htx:each>
<article class="document">
  <div class="doc-body-wrapper">
    <header class="doc-header">
      <div class="doc-header-inner">
        <span class="doc-badge">Document __doc_num__</span>
        <h1>__title__</h1>
        <span class="doc-section-tag">__section__</span>
      </div>
    </header>
    <div class="doc-body pretext">
      __body_html__
    </div>
    <footer class="doc-license">
      <p>&copy; Jared Foy. Licensed under <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>.</p>
    </footer>
  </div>
</article>
</htx:each>
<htx:none>
<div class="document">
  <h1>Document Not Found</h1>
  <p>The requested document does not exist in the corpus.</p>
  <p><a href="/">Return to the index</a></p>
</div>
</htx:none>
</htx>
