<div style="max-width:400px;margin:80px auto;padding:2rem;font-family:monospace;">
  <h1 style="font-size:1.2rem;margin-bottom:1rem;">RESOLVE — Login</h1>
  <p style="color:#999;margin-bottom:1.5rem;">Seed-derived governed conversational assistant. Doc 282.</p>
  <form id="loginForm">
    <input type="password" id="tokenInput" placeholder="Access token" style="width:100%;padding:0.5rem;font-family:monospace;background:#111;color:#eee;border:1px solid #333;margin-bottom:1rem;">
    <button type="submit" style="width:100%;padding:0.5rem;font-family:monospace;background:#ff8800;color:#000;border:none;cursor:pointer;">Enter</button>
  </form>
  <script>
    document.getElementById('loginForm').addEventListener('submit', function(e) {
      e.preventDefault();
      var token = document.getElementById('tokenInput').value;
      document.cookie = 'resolve_token=' + token + '; path=/; max-age=86400; SameSite=Strict';
      window.location.href = '/resolve';
    });
  </script>
</div>
