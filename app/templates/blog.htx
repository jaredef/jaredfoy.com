<style>
  /* Medium-style blog index — serif, vertical scroll, forced single-column. */

  .content-col:has(.blog-index) {
    overflow-y: auto !important;
    overflow-x: hidden !important;
    column-count: 1 !important;
    columns: auto !important;
    height: auto !important;
    min-height: 100vh;
  }

  .blog-index {
    max-width: 42rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5rem;
    font-family: Charter, "Bitstream Charter", "Sitka Text", Cambria, Georgia, serif;
    color: var(--fg);
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  .blog-index .blog-kicker {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--fg) 55%, transparent);
    margin: 0 0 1.25rem;
  }

  .blog-index h1 {
    font-family: inherit;
    font-size: clamp(2rem, 4.5vw, 2.9rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0 0 0.75rem;
  }

  .blog-index .blog-intro {
    font-size: 1.15rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--fg) 78%, transparent);
    font-style: italic;
    margin: 0 0 3rem;
  }

  .blog-index .blog-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .blog-index .blog-list li {
    border-bottom: 1px solid var(--border);
  }

  .blog-index .blog-list a {
    display: block;
    color: inherit;
    text-decoration: none;
    padding: 1.75rem 0;
    transition: opacity 0.15s ease;
  }

  .blog-index .blog-list a:hover {
    opacity: 0.72;
  }

  .blog-index .blog-list h2 {
    font-family: inherit;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0 0 0.4rem;
  }

  .blog-index .blog-list .post-kicker {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--fg) 55%, transparent);
  }

  .blog-index .blog-empty {
    color: color-mix(in srgb, var(--fg) 60%, transparent);
    font-style: italic;
    padding: 2rem 0;
  }

  @media (max-width: 768px) {
    .blog-index { padding: 1.75rem 1rem 4rem; }
    .blog-index h1 { font-size: 1.8rem; }
    .blog-index .blog-intro { font-size: 1.05rem; margin-bottom: 2rem; }
    .blog-index .blog-list h2 { font-size: 1.3rem; }
  }
</style>

<section class="blog-index">
  <p class="blog-kicker">jaredfoy.com</p>
  <h1>Blog</h1>
  <p class="blog-intro">Essays for the general reader.</p>

  <htx:type>blog</htx:type>
  <htx:status>published</htx:status>
  <htx:howmany>500</htx:howmany>
  <htx>
    <ul class="blog-list">
      <htx:each>
        <li>
          <a href="/resolve/blog/__slug__">
            <h2>__title__</h2>
            <span class="post-kicker">Read →</span>
          </a>
        </li>
      </htx:each>
      <htx:none>
        <li class="blog-empty">No posts yet.</li>
      </htx:none>
    </ul>
  </htx>
</section>
