<style>
  /* Home-page sphere hero. Desktop only: the coherence sphere runs behind
     the hero text as an ambient, draggable backdrop. Below 768px (matching
     the site's existing mobile breakpoint) the sphere canvas is hidden and
     three.js is never loaded, so mobile stays fast. */
  .hero.hero-with-sphere {
    position: relative;
    min-height: min(70vh, 560px);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
  }

  .home-sphere-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: auto;
  }

  .home-sphere-canvas canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  .hero-with-sphere .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 44rem;
    text-align: center;
    padding: 2rem 1.75rem;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--bg) 88%, transparent) 0%,
      color-mix(in srgb, var(--bg) 72%, transparent) 55%,
      color-mix(in srgb, var(--bg) 35%, transparent) 90%,
      transparent 100%
    );
    border-radius: 8px;
  }

  .home-sphere-tooltip {
    position: fixed;
    display: none;
    max-width: 320px;
    background: color-mix(in srgb, var(--bg) 95%, transparent);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.55rem 0.75rem;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--fg);
    pointer-events: none;
    z-index: 100;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .home-sphere-hint {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    z-index: 2;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--fg) 45%, transparent);
    pointer-events: none;
  }

  .home-sphere-hint a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted currentColor;
    pointer-events: auto;
  }

  @media (max-width: 768px) {
    .hero.hero-with-sphere {
      min-height: auto;
      padding: 2rem 1rem;
    }
    .home-sphere-canvas,
    .home-sphere-hint {
      display: none;
    }
    .hero-with-sphere .hero-inner {
      background: none;
      padding: 0.5rem 0.25rem;
      max-width: 100%;
    }
  }

  /* "Entries" section — each card surfaces a different visualization as
     a constraint-named axis. Visually denser than .series-card so the four
     visualization cards read as a distinct pattern from the textual series
     paths above. */
  .entries-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.85rem;
    margin: 0.5rem 0 0.25rem;
  }
  .entry-card {
    display: block;
    padding: 1rem 1.1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: color-mix(in srgb, var(--bg) 96%, var(--fg) 4%);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
    position: relative;
    overflow: hidden;
  }
  .entry-card:hover {
    border-color: color-mix(in srgb, var(--fg) 45%, transparent);
    transform: translateY(-1px);
  }
  .entry-axis {
    display: block;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--fg) 55%, transparent);
    margin-bottom: 0.4rem;
  }
  .entry-card h3 {
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .entry-card p {
    font-size: 0.86rem;
    line-height: 1.5;
    margin: 0;
    color: color-mix(in srgb, var(--fg) 78%, transparent);
  }
  .entry-card .entry-arrow {
    position: absolute;
    top: 0.95rem;
    right: 1rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--fg) 35%, transparent);
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .entry-card:hover .entry-arrow {
    color: color-mix(in srgb, var(--fg) 75%, transparent);
    transform: translateX(2px);
  }

  /* Each card carries a faint colored bar along its left edge tied to the
     axis it surfaces — the same hue family the visualization itself uses,
     so the card reads as a fragment of the destination. */
  .entry-card[data-axis="time"]    { box-shadow: inset 3px 0 0 #f59e0b; }
  .entry-card[data-axis="semantics"] { box-shadow: inset 3px 0 0 #34d399; }
  .entry-card[data-axis="citation"] { box-shadow: inset 3px 0 0 #7c8aff; }
  .entry-card[data-axis="pipeline"] { box-shadow: inset 3px 0 0 #f472b6; }

  /* See-all link trailing each series section on the home page. Small,
     right-aligned, mono-spaced, subtle accent — visible but not competing
     with the curated top-5 list above it. */
  .series-see-all-wrap {
    margin: 1rem 0 0;
    text-align: right;
  }

  .series-see-all {
    display: inline-block;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--fg) 65%, transparent);
    text-decoration: none;
    padding: 0.35rem 0.6rem;
    border-bottom: 1px solid color-mix(in srgb, var(--fg) 25%, transparent);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .series-see-all:hover {
    color: var(--fg);
    border-color: color-mix(in srgb, var(--fg) 55%, transparent);
  }

  /* Yellow reader's notice banner above the hero. Low-key but visible;
     signals that the site is an experimental sandbox rather than a body of
     settled claims. */
  .reader-notice {
    background: #fef3c7;
    color: #78350f;
    border: 1px solid #f59e0b;
    border-radius: 6px;
    padding: 0.65rem 1rem;
    margin: 0 auto 1.25rem;
    max-width: 44rem;
    font-size: 0.85rem;
    line-height: 1.45;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
  }
  .reader-notice strong {
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }
  .reader-notice p {
    margin: 0.35rem 0 0;
    font-family: var(--font-body, system-ui, sans-serif);
  }

  @media (prefers-color-scheme: dark) {
    .reader-notice {
      background: color-mix(in srgb, #f59e0b 18%, var(--bg));
      color: color-mix(in srgb, #fde68a 80%, var(--fg));
      border-color: color-mix(in srgb, #f59e0b 55%, transparent);
    }
  }

  @media (max-width: 768px) {
    .reader-notice {
      margin: 0.5rem 0.75rem 1rem;
      font-size: 0.78rem;
    }
  }

</style>

<div class="reader-notice" role="note">
  <strong>Reader's notice</strong>
  <p>This is a <a href="/resolve/coherence">coherence sphere</a> &mdash; one practitioner's documented sustained operation of LLM-augmented research methodology applied to philosophical inquiry. Outputs are at plausibility-tier under the corpus's own warrant discipline; cross-practitioner replication for higher warrant has not been performed. The apparatus is a functional synthesis-machine, not a novel methodology. Most claims are subsumable under existing literature in interdisciplinary research, AI-augmented inquiry, and philosophy of science. See <a href="/resolve/about-the-project">About the Project</a> for the full scope and limits. Read with epistemic care.</p>
</div>

